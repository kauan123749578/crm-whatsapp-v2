{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "cd crm-v2 && chmod +x build.sh && ./build.sh"
  },
  "deploy": {
    "startCommand": "cd crm-v2 && npm start",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
